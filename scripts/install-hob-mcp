#!/bin/sh
# Builds hob-mcp in release mode and installs it to the main checkout's
# .bin/, where scripts/hob-mcp (run by .mcp.json) finds it, also from a Git
# worktree. A copy there isn't touched by work in progress or `cargo clean`.
# Reconnect the MCP server (/mcp in Claude Code) afterwards.
set -eu
cd "$(dirname "$0")/.."
cargo build --release -p hob-mcp
git_dir=$(git rev-parse --path-format=absolute --git-common-dir)
bin="$(dirname "$git_dir")/.bin"
mkdir -p "$bin"
# Replace it by renaming, so a running server keeps its old binary.
cp target/release/hob-mcp "$bin/hob-mcp.new"
mv "$bin/hob-mcp.new" "$bin/hob-mcp"
echo "Installed $bin/hob-mcp"
